DATABASE_URL=postgres://postgres:postgres@localhost:5432/gitfuse
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
# Server-only 32-byte key for reversible Pairing PIN encryption.
# Generate with: openssl rand -hex 32
PAIRING_PIN_ENCRYPTION_KEY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITFUSE_RELAY_URL=http://localhost:8787
PAYMENT_PROVIDER=razorpay
# Razorpay Dashboard > Account & Settings > API Keys.
RAZORPAY_KEY_ID=
# Razorpay Dashboard > Account & Settings > API Keys. Keep this server-only.
RAZORPAY_KEY_SECRET=
# Razorpay Dashboard > Webhooks. Use the signing secret for the billing webhook.
RAZORPAY_WEBHOOK_SECRET=
# Razorpay Dashboard > Subscriptions > Plans. Required by the subscription fallback flow.
RAZORPAY_PRO_PLAN_ID=
RAZORPAY_TEAM_PLAN_ID=
# Public checkout key from Razorpay Dashboard > Account & Settings > API Keys.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
NEXT_PUBLIC_APP_URL=http://localhost:3000
# International payments require enablement on the Razorpay merchant account.
RESEND_API_KEY=
RESEND_FROM_EMAIL=gitfuse <notifications@gitfuse.dev>
GITFUSE_AUTH_EMAIL_LOG=/tmp/gitfuse-auth-otp.log
EMAIL_JOB_SECRET=

EMAIL_PROVIDER=gmail
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER_EMAIL=
GMAIL_FROM_NAME=GitFuse
